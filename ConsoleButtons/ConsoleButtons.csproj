<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>ConsoleButtons</RootNamespace>
    <AssemblyName>ConsoleButtons</AssemblyName>
    <AssemblyTitle>Console Buttons</AssemblyTitle>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ConsoleButtons</PackageId>
    <Version>3.0.0</Version>
    <Authors>Technoo</Authors>
    <Company>Technoo</Company>
    <Product>ConsoleButtons</Product>
    <Title>Console Buttons</Title>
    <Description>Clickable UI for C# Console. Buttons, checkboxes, sliders and more!</Description>
    <PackageTags>console;ui;buttons;checkbox;slider;mouse;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wTechnoo/ConsoleButtons</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wTechnoo/ConsoleButtons</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © Technoo 2021</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
